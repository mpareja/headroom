{
  "name": "headroom",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=8",
    "npm": ">=3"
  },
  "nyc": {
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100,
    "cache": true,
    "check-coverage": true,
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "standard": {
    "env": [
      "mocha",
      "node"
    ]
  },
  "scripts": {
    "clean": "rimraf .nyc_output coverage",
    "cov": "opener coverage/lcov-report/index.html",
    "lint": "standard --env mocha",
    "mount": "sudo sshfs -o allow_other,default_permissions mpareja@sonic:/mnt/data/headroom/datastore datastore/",
    "test": "npm run clean && npm run lint && nyc npm run test-only",
    "test-only": "mocha --recursive --reporter ${MOCHA_REPORTER:-spec}",
    "watch-test": "mocha --recursive -w"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "chai": "^5.2.0",
    "memfs": "^4.17.2",
    "mocha": "^11.6.0",
    "nock": "^14.0.5",
    "nyc": "^17.1.0",
    "opener": "^1.5.2",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/material": "^7.1.1",
    "@mui/icons-material": "^7.1.1",
    "bluebird": "^3.7.2",
    "isomorphic-unfetch": "^4.0.2",
    "next": "^15.3.3",
    "p-queue": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "standard": "^17.1.2"
  }
}
